# ==============================================================================
# gitcsv Environment Variables (.env.local or .env)
# ==============================================================================
# Copy this file to .env.local in your project root if you prefer configuring via env vars.
# All variables are OPTIONAL: gitcsv will automatically fall back to .gitcsv/config.json.

# --- Project Target Configuration ---
# GITCSV_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
# GITCSV_CSV_DIR=Assets/CSV

# --- Authentication Configuration ---
# Mode can be "oauth" (Google browser login) or "service_account" (Service Account key JSON)
# GITCSV_AUTH_MODE=oauth

# Path to Google OAuth Client secret or Service Account JSON file:
# GITCSV_CREDENTIALS_FILE=credentials.json

# Path to store the user's OAuth access & refresh token:
# GITCSV_TOKEN_FILE=.gitcsv/token.json

# Alternatively, you can paste the raw JSON string directly:
# GITCSV_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"..."}}
